<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TA Assignment Form</title>
</head>
<body>

    <h1>Course Creation Form</h1>
    <form id="TaAssignmentForm" action="#" method="post">
        <label for="course">Choose Course:</label>
        <select name="course" required>
            <option value="" disabled selected>  </option>
            <option value="course1">Data Structures and Algorthims</option>
            <option value="course2">Software Requirements</option>
            <option value="course3">Operating Systems</option>    
        </select>

        <label for="TA">Choose TA:</label>
        <select name="TA" required>
            <option value="" disabled selected>  </option>
            <option value="TA1">Abdulrahman Raad</option>
            <option value="instructor2">Mohammed Deri</option>
            <option value="instructor3">Ahmed Fares</option>
        </select>

        <label for="TA total assigned hours">Total assigned hours:</label>
        <input type="number" id="TA total assigned hours" name="TA total assigned hours" min="1" max="18" step="1" required>

        <img src="https://yt3.ggpht.com/a/AGF-l7-B1MoykDFAHDRm6stJIOXGZUL_27inMLGRXQ=s900-c-k-c0xffffffff-no-rj-mo" alt="Logo" class="logo" width="150" height="150">

        <button type="submit">Submit</button>
    </form>
</body>
</html>